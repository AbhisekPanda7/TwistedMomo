# Production image, built by .github/workflows/backend-image.yml.
#
# Separate from ./Dockerfile because CI has no persistent layer cache: the
# dependency layer is restored there by caching ~/.m2 around the build instead.

FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build

COPY pom.xml .
RUN mvn -B dependency:go-offline

COPY src ./src

# .git is excluded from the build context, so the git-commit-id plugin finds no
# repository here and /actuator/info would report an empty git block — on exactly
# the deployed artifact the endpoint exists to identify. CI passes the SHA it
# already knows, and build-info records it instead.
ARG GIT_COMMIT=unknown
RUN mvn -B clean package -DskipTests -Dbuild.git.commit="$GIT_COMMIT"

FROM eclipse-temurin:21-jre AS runtime
WORKDIR /app

RUN groupadd --system spring \
 && useradd --system --gid spring spring

COPY --from=build /build/target/backend.jar app.jar

# Matches app.upload.dir. Bound to a named volume in compose so images uploaded
# through the admin UI survive a redeploy.
RUN mkdir -p /app/uploads && chown -R spring:spring /app

# Nothing in this container needs privileges.
USER spring
EXPOSE 8080

# Heap tracks the container limit rather than a hardcoded -Xmx, so the memory
# budget is set in one place — the compose file — not two.
ENV JAVA_OPTS="-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=40"

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
