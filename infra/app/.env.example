# Copy to .env and fill in. NEVER commit the filled-in file.
#
# In production these are set in the Dokploy UI (Environment tab), not in a file
# on the server. This template exists so the required set is reviewable in git.

# --- Image -------------------------------------------------------------------
# Built and pushed by .github/workflows/backend-image.yml. Pin to a commit sha
# instead of :latest to roll back.
BACKEND_IMAGE=ghcr.io/abhisekpanda7/twistedmomo-backend:latest

# --- Cloudflare Tunnel -------------------------------------------------------
# From the Zero Trust dashboard when the tunnel is created (runbook step 9).
# This is a bearer credential: anyone holding it can run a connector for your
# tunnel. Treat it like a password.
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token

# --- Database ----------------------------------------------------------------
# MYSQL_ROOT_PASSWORD only initialises the server; the application connects as
# MYSQL_USER, which has rights on MYSQL_DATABASE alone.
# Generate each with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=change-me-long-random
MYSQL_DATABASE=twisted_momos
MYSQL_USER=twistedmomos
MYSQL_PASSWORD=change-me-long-random

# --- Backend (application-prod.yml requires all four, no defaults) ------------
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/twisted_momos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=twistedmomos
SPRING_DATASOURCE_PASSWORD=change-me-long-random

# 32+ bytes of high entropy. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-bytes-of-high-entropy

# Comma-separated, no trailing slashes. The deployed Vercel frontend.
CORS_ALLOWED_ORIGINS=https://twistedmomos.vercel.app
