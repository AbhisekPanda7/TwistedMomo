# Copy to .env and fill in. NEVER commit the filled-in file.
#
# In production these are set in the Dokploy UI (Environment tab), not in a file
# on the server. This template exists so the required set is reviewable in git.

# --- Images ------------------------------------------------------------------
# Built and pushed by the workflows in .github/workflows/. Pin to a commit sha
# instead of :latest to roll back.
BACKEND_IMAGE=ghcr.io/abhisekpanda7/twistedmomo-backend:latest
FRONTEND_IMAGE=ghcr.io/abhisekpanda7/twistedmomo-frontend:latest

# --- Cloudflare Tunnel -------------------------------------------------------
# From the Zero Trust dashboard when the tunnel is created (runbook step 9).
# This is a bearer credential: anyone holding it can run a connector for your
# tunnel. Treat it like a password.
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token

# --- Database ----------------------------------------------------------------
# MYSQL_ROOT_PASSWORD only initialises the server; the application connects as
# MYSQL_USER, which has rights on MYSQL_DATABASE alone.
# Generate each with: openssl rand -base64 32
MYSQL_ROOT_PASSWORD=change-me-long-random
MYSQL_DATABASE=twisted_momos
MYSQL_USER=twistedmomos
MYSQL_PASSWORD=change-me-long-random

# --- Backend (application-prod.yml gives none of these a default) ------------
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/twisted_momos?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=twistedmomos
SPRING_DATASOURCE_PASSWORD=change-me-long-random

# 32+ bytes of high entropy. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-bytes-of-high-entropy

# Comma-separated, no trailing slashes. The frontend is served by the nginx
# container in this same stack, reached at the apex through the tunnel. Add
# https://www.twistedmomos.tech too if a public hostname exists for it.
CORS_ALLOWED_ORIGINS=https://twistedmomos.tech

# Public site origin, no trailing slash. Verification links in emails point
# here, so a wrong value ships dead links to real users.
FRONTEND_BASE_URL=https://twistedmomos.tech

# --- Email (Resend) ----------------------------------------------------------
# Without a key the backend silently falls back to a logging adapter: signups
# succeed and nobody ever receives a verification link. application-prod.yml has
# no default, so a missing value fails startup instead.
RESEND_API_KEY=re_change-me
# The domain must be verified in Resend or every send is rejected.
NOTIFICATION_FROM_EMAIL=noreply@twistedmomos.tech

# --- Google sign-in -----------------------------------------------------------
# The audience every Google ID token is checked against. Not a secret — the same
# value is compiled into the frontend bundle. It must match the client id the
# frontend was built with, or every sign-in is rejected as the wrong audience.
GOOGLE_CLIENT_ID=169514872036-2gtu17rkobtapfbfi2q3901tqp354q9i.apps.googleusercontent.com
