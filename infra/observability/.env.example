# Copy to .env and fill in. NEVER commit the filled-in file.

# Grafana admin. The panel binds to 127.0.0.1 and is reached over Tailscale, but a
# weak password here still exposes every log line the application emits.
# Generate with: openssl rand -base64 24
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-long-random
