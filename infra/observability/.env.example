# Copy to .env and fill in. NEVER commit the filled-in file.

# The host's Tailscale IP — `tailscale ip -4` on the box. Grafana binds to this
# interface alone, so it is reachable at http://<hostname>:3001 from any device
# on the tailnet and from nowhere else. 127.0.0.1 restricts it to loopback, which
# then needs `ssh -L 3001:127.0.0.1:3001` to reach.
GRAFANA_BIND_IP=100.126.48.73

# Grafana admin. The panel is off the public internet either way, but a weak
# password here still exposes every log line the application emits to anyone on
# the tailnet.
# Generate with: openssl rand -base64 24
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-long-random
