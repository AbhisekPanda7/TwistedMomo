# This is a monorepo — frontend/ and backend/ each own a self-contained .gitignore
# for their build tools' output (node_modules, dist, target, etc). This root-level
# file only covers things that can show up regardless of which package you're in.

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log

# Infra secrets — see infra/.gitignore for the full rules
infra/**/.env

# Compose reads this automatically — it holds the Resend key locally.
/.env
.claude
