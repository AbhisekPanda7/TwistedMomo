# Copy to .env for local development. Docker Compose reads .env automatically.

# Google OAuth web client id. Not a secret — the same value is compiled into the
# frontend bundle. Backend and frontend must agree or every sign-in is rejected
# as the wrong audience, so compose feeds both from this one variable.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional. Without it the backend logs verification emails instead of sending
# them, which is usually what you want locally.
RESEND_API_KEY=
