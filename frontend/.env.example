## Copy to .env for local development. Vite only exposes vars prefixed VITE_.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google OAuth web client id. Not a secret — it ships in the bundle. Without it
# the Google button silently does not render and email sign-in still works.
VITE_GOOGLE_CLIENT_ID=169514872036-2gtu17rkobtapfbfi2q3901tqp354q9i.apps.googleusercontent.com
