# Production image, built by .github/workflows/frontend-image.yml.
#
# Separate from ./Dockerfile, which runs the Vite dev server with HMR and has no
# static stage on purpose. This one builds dist/ and serves it from nginx.

FROM node:22-alpine AS build
WORKDIR /build

# Lockfile-only install layer: npm ci reruns solely when a manifest changes.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Vite inlines VITE_* values into the bundle at build time — they are not read
# from the environment at runtime. The API URL therefore has to arrive here, as a
# build argument, and changing it means rebuilding the image rather than editing
# a variable in Dokploy.
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

FROM nginx:1.27-alpine AS runtime

# React Router owns the client-side routes, so nginx must return index.html for
# any path it cannot find on disk — otherwise a refresh on /admin/orders 404s.
# Hashed assets are immutable and safe to cache hard; index.html never is, or a
# deploy would keep serving the previous bundle.
RUN printf 'server {\n\
  listen 80;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
\n\
  location /assets/ {\n\
    expires 1y;\n\
    add_header Cache-Control "public, immutable";\n\
  }\n\
\n\
  location / {\n\
    try_files $uri $uri/ /index.html;\n\
    add_header Cache-Control "no-cache";\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf

COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80

# nginx:alpine already drops to the nginx user for workers; the master needs root
# to bind 80 inside the container. No port is published to the host regardless —
# cloudflared reaches this over the Docker network.
